# This file contains the fastlane configuration
# You can find the documentation at https://docs.fastlane.tools

default_platform(:android)

platform :android do
  desc "Build Release APK"
  lane :build_release do
    Dir.chdir("..") do
      sh("flutter", "clean")
      sh("flutter", "pub", "get")
      sh("flutter", "build", "apk", "--release")
    end
  end

  desc "Deploy to Production - Build and optionally deploy to Firebase"
  lane :deploy_production do
    build_release
    
    UI.success("✅ Production build completed successfully!")
    UI.message("APK location: ../build/app/outputs/flutter-apk/app-release.apk")
  end

  desc "Deploy to Firebase App Distribution"
  lane :firebase_distribution do
    Dir.chdir("..") do
      sh("flutter", "clean")
      sh("flutter", "build", "apk", "--release", "--no-tree-shake-icons")
    end
    
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      firebase_cli_token: ENV["FIREBASE_CLI_TOKEN"],
      android_artifact_type: "APK",
      android_artifact_path: "../build/app/outputs/flutter-apk/app-release.apk",
      testers: ENV["FIREBASE_TESTERS"] || "osama.hamad.developer@gmail.com",
      release_notes: "Benaa Offline App - #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}"
    )
    
    UI.success("✅ Successfully deployed to Firebase App Distribution!")
  end
end
